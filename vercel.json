{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/api/bridge", "dest": "/api/regenerate-week" },
    { "src": "/api/derivatives", "dest": "/api/regenerate-week" },
    { "src": "/api/figure", "dest": "/api/regenerate-week" },
    { "src": "/api/illustrate", "dest": "/api/regenerate-week" },
    { "src": "/api/production", "dest": "/api/regenerate-week" },
    { "src": "/api/lesson-plan", "dest": "/api/regenerate-week" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
