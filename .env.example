# Provedor: openai (padrão) ou anthropic/claude. Nunca commit .env real.
AI_PROVIDER=openai
# Para usar Claude, preencha ANTHROPIC_API_KEY e altere AI_PROVIDER para anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelos Claude recentes recusam "temperature"; só ative se o seu modelo aceitar.
# ANTHROPIC_SEND_TEMPERATURE=false
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_ASSIST_MAX_TOKENS=6000
ANTHROPIC_REQUEST_TOKEN_BUDGET=28000
ANTHROPIC_REGEN_MAX_TOKENS=10000
ANTHROPIC_MAX_RETRIES=3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Opcional: modelo separado para texto longo; se vazio, usa OPENAI_MODEL.
OPENAI_CONTENT_MODEL=
# Aumenta o espaço para uma unidade didática completa em JSON.
OPENAI_MAX_TOKENS=16000
# Limite separado para completar campos vazios do briefing.
OPENAI_ASSIST_MAX_TOKENS=6000
# Limite separado para regeneração de uma semana com contexto compacto.
OPENAI_REGEN_MAX_TOKENS=10000
# Geração de uma semana por requisição; false reativa o pipeline mais longo.
AULA_SINGLE_PASS=true
# Redação em prosa (padrão) ou "json" para o modo anterior.
AULA_WRITER=prose
# Opcional: limite de tokens de saída da redação (padrão: calculado pela meta de palavras).
# AULA_WRITER_MAX_TOKENS=12000
# Limite curto para provedores de pesquisa dentro da função serverless.
AULA_RESEARCH_TIMEOUT_MS=8000
# Repetições automáticas para 429/503, respeitando Retry-After quando enviado.
OPENAI_MAX_RETRIES=3
# Uma semana por vez reduz picos de tokens por minuto; aumente somente se houver folga.
AULA_AI_BATCH_SIZE=1
# Pipeline em três fases: planejamento, redação e revisão crítica.
AULA_ACADEMIC_PIPELINE=true
AULA_ACADEMIC_REVIEW=true
# Se true, uma semana curta/incompleta recebe uma segunda tentativa editorial.
AULA_AUTO_REPAIR=true
AULA_ACCESS_CODE=crie-um-codigo-privado-diferente-da-chave-openai
# YouTube Data API v3: necessária para localizar vídeos reais por tema.
YOUTUBE_API_KEY=
# Opcional: e-mail para o polite pool do Crossref.
CROSSREF_MAILTO=
# Fallback público para referências quando o Crossref retornar poucos candidatos.
AULA_OPENALEX_ENABLED=true
# true por padrão; use false apenas para diagnosticar uma geração sem pesquisa.
AULA_RESOURCE_RESEARCH=true
HOST=127.0.0.1
PORT=4310
