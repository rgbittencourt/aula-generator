# Provider OpenAI-compatible. Nunca commit .env real.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AULA_ACCESS_CODE=crie-um-codigo-privado-diferente-da-chave-openai
# YouTube Data API v3: necessária para localizar vídeos reais por tema.
YOUTUBE_API_KEY=
# Opcional: e-mail para o polite pool do Crossref.
CROSSREF_MAILTO=
# true por padrão; use false apenas para diagnosticar uma geração sem pesquisa.
AULA_RESOURCE_RESEARCH=true
HOST=127.0.0.1
PORT=4310
